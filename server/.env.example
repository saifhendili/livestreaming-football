# Copy to .env to override the defaults.
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27020/livestreaming

# Only when the web app is hosted on a different origin than the API (e.g. Vercel + Render).
# Comma-separated, no trailing slash: CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# Where matches are scraped from
SOURCE_URL=https://fast-shot.com

# Second match source: the feed behind yacinetv.website (Matches page -> "Yacine TV" tab)
# YACINE_API_URL=https://cdn.kora-api.org/api/v1/matches

# TV channels come from the open iptv-org catalogue and the Free-TV playlist;
# hours before each is downloaded again
IPTV_TTL_HOURS=6

# Drama Live: server-side AES API and HLS playback adapter.
DRAMA_FG_CODE=202122
# Optional endpoint overrides:
# DRAMA_LIVE_URL=http://live.chiefapisource.pro/api/live/livedrama/v13.0.0
# DRAMA_REDIRECT_URL=http://redirect.chiefapisource.pro/redirect
# Use the same secret on every API instance; keep it private.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRAMA_PROXY_SECRET=

# Seconds a scraped day listing stays fresh before the next request re-scrapes it
LISTING_TTL_SECONDS=60
# Seconds resolved stream links are reused (empty results are retried after EMPTY_STREAM_TTL_SECONDS)
STREAM_TTL_SECONDS=120
EMPTY_STREAM_TTL_SECONDS=20
